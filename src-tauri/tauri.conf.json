{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cute-frpc-tauri",
  "version": "0.1.0",
  "identifier": "com.ivory.cute-frpc-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "蓝联花",
        "width": 480,
        "height": 720,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/frpc"
    ],
    "resources": [
      "resources/default_config.toml"
    ]
  }
}
