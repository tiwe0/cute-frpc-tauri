{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bluelotus",
  "version": "0.2.5",
  "identifier": "cafe.ivory.frpc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "蓝连哈",
        "width": 480,
        "height": 750,
        "resizable": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/frpc"
    ],
    "resources": [
      "resources/default_config.toml"
    ]
  }
}
